# Veritabanı bağlantı bilgileri
DB_USER=nexstream
DB_PASSWORD=nexstream
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexstream_db

# Groq API
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# API Güvenlik Anahtarı (scrape ve reindex endpoint'leri için)
API_KEY=change-me-in-production

# ChromaDB (local test için)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Loglama
LOG_LEVEL=INFO
LOG_FORMAT=json

# v1.11 — Monetizasyon & erişim
# Stripe'sız lokal demo: true iken /billing/checkout tier'ı anında yükseltir.
# PRODUCTION'DA ASLA TRUE YAPMA.
BILLING_DEV_MODE=false
# Virgülle ayrılmış e-posta listesi — eşleşen kullanıcılar admin sayılır
ADMIN_EMAILS=

# Güvenlik denetimi (v1.17) — prod'da ENVIRONMENT=production set edilirse
# API_KEY/BILLING_DEV_MODE/CORS_ORIGINS/SESSION_COOKIE_SECURE zayıf/varsayılan
# bırakılmışsa uygulama açılışı REDDEDER (settings.py::_reject_unsafe_production_config).
# Lokal dev'de bu satırı hiç eklemeyin — varsayılan "development" guard'ı devre dışı bırakır.
ENVIRONMENT=development
# Virgülle ayrılmış origin listesi — prod'da gerçek domain'e sabitlenmeli
# (örn. https://nexstream.news), asla "*" bırakılmamalı.
CORS_ORIGINS=http://localhost:3000

# Grafana admin şifresi — SADECE docker-compose.prod.yml'de zorunlu (":?" ile
# unutulursa deploy hata verir). Güçlü/rastgele üretin: openssl rand -hex 16
GRAFANA_PASSWORD=
